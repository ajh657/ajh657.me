<div class="main-window-body window-body has-space">
    <div class="grid-layout grid-layout-badged">
        <div class="grid-nav">
            {{ include "nav/nav.vto"}}
        </div>
        <div class="grid-content">
            {{content}}
        </div>
        <div class="grid-badges">
            <fieldset>
                <legend>Badges</legend>
                {{include "components/badge.vto"}}
            </fieldset>
        </div>
    </div>
</div>